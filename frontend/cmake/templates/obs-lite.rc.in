#include <winver.h>

IDI_ICON1 ICON "obs-lite.ico"

#define OBS_LIGHT_VERSION_MAJOR @OBS_VERSION_MAJOR@
#define OBS_LIGHT_VERSION_MINOR @OBS_VERSION_MINOR@
#define OBS_LIGHT_VERSION_PATCH @OBS_VERSION_PATCH@

#define OBS_LIGHT_VERSION_STRING "@OBS_VERSION@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OBS_LIGHT_VERSION_MAJOR, OBS_LIGHT_VERSION_MINOR, OBS_LIGHT_VERSION_PATCH, 0
 PRODUCTVERSION OBS_LIGHT_VERSION_MAJOR, OBS_LIGHT_VERSION_MINOR, OBS_LIGHT_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@OBS_COMPANY_NAME@"
            VALUE "FileDescription", "obs-lite - @OBS_COMMENTS@"
            VALUE "FileVersion", OBS_LIGHT_VERSION_STRING
            VALUE "InternalName", "obs-lite"
            VALUE "LegalCopyright", "@OBS_LEGAL_COPYRIGHT@"
            VALUE "OriginalFilename", "obs-lite.exe"
            VALUE "ProductName", "@OBS_PRODUCT_NAME@"
            VALUE "ProductVersion", OBS_LIGHT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
